# ============================================================================
# AI House Kit — 填一个 Key 即可养一屋子 AI 室友（不填也能跑内置演示模式！）
# 建议直接运行 `ai-house init` 自动生成高强度令牌与干净的 `.env` 文件。
# ============================================================================

# 1. 模型接口配置（支持 OpenAI / Gemini 兼容端点 / DeepSeek / Ollama 等任何 OpenAI 协议）
#    留空也能以零配置内置演示模式启动；填入 Key 后立即启用真实对话、记忆整理与日记生成。
AI_HOUSE_API_KEY=
AI_HOUSE_BASE_URL=https://api.openai.com
AI_HOUSE_MODEL=gpt-4o-mini

#    可选：主模型限流或超时时自动切换备用模型（Fallback）
AI_HOUSE_FALLBACK_API_KEY=
AI_HOUSE_FALLBACK_BASE_URL=
AI_HOUSE_FALLBACK_MODEL=
AI_HOUSE_TOOLS_LOOP=1

#    可选：模型调用的总时限（秒；含重试、回退与工具循环）。0 或留空表示用默认值（不是不限时）。
#    AI_HOUSE_LLM_TOTAL_BUDGET_S=45          # 单次调用；也可按用途写 AI_HOUSE_<CHAT|LIFE|DIARY|MEMORY_EXTRACT>_TOTAL_BUDGET_S
#    AI_HOUSE_CONVERSE_BUDGET_S=             # 一轮对话生成回复的上限；默认 = 单次预算 x 回话人数
#    AI_HOUSE_ATTACHMENT_BUDGET_S=10         # 附件预处理的总时限

# 2. 监听、端口与安全令牌
#    监听 127.0.0.1 本机默认免令牌；绑定 0.0.0.0 或 Docker 运行时必须设置 ≥16 位的 AI_HOUSE_OWNER_TOKEN
#    生成强令牌：python -c "import secrets; print(secrets.token_urlsafe(24))"
AI_HOUSE_HOST=127.0.0.1
AI_HOUSE_PORT=8780
AI_HOUSE_OWNER_TOKEN=
AI_HOUSE_READ_TOKEN=
AI_HOUSE_WRITE_TOKEN=
AI_HOUSE_PRIVATE_TOKEN=

# 3. 世界内容包与内置插件（默认樱丘 6 人洋馆；填写 indie-studio-3 即切换 3 人独立游戏工作室）
AI_HOUSE_PACK_DIR=
BOTGAME_HOUSE_ROSTER_JSON=
AI_HOUSE_TOOLS=sticker_pack,dice_tabletop,book_nook
AI_HOUSE_BOOK_NOOK=1

# 4. 晴空都联动 · 模式 A：本地双容器私享晴空都（配合 docker compose --profile city up -d）
WORLD_KERNEL_CITY_BRIDGE=0
CITY_PROFILE=qingkong
CITY_BRIDGE_URL=http://qingkong-city:7700/city/bridge/v1
#    必须至少 24 位（`ai-house init` 会自动生成；未启用时留空或保留生成的随机串均可）
CITY_BRIDGE_KEY=

# 5. 晴空都联动 · 模式 B（实验性）：接入公共联机晴空都（每位出场室友需独立令牌）
CITY_FEDERATION_MCP_URL=
CITY_FEDERATION_HOUSE_TAG=樱丘小屋
CITY_FEDERATION_TOKEN_NELL=
CITY_FEDERATION_TOKEN_YUKI=

# 6. 可选 QQ 接入（通用 OneBot v11 正向 WebSocket；协议端需自备，接口要求见 docs/DEPLOY.md 第 2.1 节）
#    注意：必须填写 ONEBOT_OWNER_QQ（可用逗号填多个房主 QQ）；ONEBOT_ACTOR 默认为名单第一位；ONEBOT_GROUPS 可选
ONEBOT_WS_URL=
ONEBOT_ACCESS_TOKEN=
ONEBOT_OWNER_QQ=
ONEBOT_ACTOR=
ONEBOT_GROUPS=
